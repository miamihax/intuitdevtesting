ANTHROPIC_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Invoice OCR import pipeline (see app/ocr.py). Point these at your local
# Tesseract executable and Poppler "bin" folder if they aren't on PATH.
TESSERACT_CMD=
POPPLER_PATH=

# Primary geocoder (see app/geocode.py) -- forgiving free-text search that
# resolves messy OCR/invoice addresses far more often than OpenStreetMap's
# strict parser. Get a free key (100,000 requests/month) at
# https://cloud.maptiler.com/account/keys/ — leave blank to fall back
# straight to OpenStreetMap.
MAPTILER_API_KEY=

# Geocoding fallback (see app/geocode.py): when an address can't be found on
# OpenStreetMap (or MapTiler) at all, search the web for the store name and
# geocode whatever street address turns up. Get a free key (2,000
# queries/month) at https://brave.com/search/api — leave blank to skip this
# fallback.
BRAVE_SEARCH_API_KEY=

# QuickBooks Online invoice webhook import pipeline (see app/quickbooks.py).
# Create an app at https://developer.intuit.com to get the client id/secret,
# add QBO_REDIRECT_URI as the app's redirect URI, and set the app's Webhooks
# endpoint to {your public backend URL}/api/quickbooks/webhook — the
# Verifier Token shown there goes in QBO_WEBHOOK_VERIFIER_TOKEN.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=
