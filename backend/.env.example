ANTHROPIC_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Invoice OCR import pipeline (see app/ocr.py). Point these at your local
# Tesseract executable and Poppler "bin" folder if they aren't on PATH.
TESSERACT_CMD=
POPPLER_PATH=

# QuickBooks Online invoice webhook import pipeline (see app/quickbooks.py).
# Create an app at https://developer.intuit.com to get the client id/secret,
# add QBO_REDIRECT_URI as the app's redirect URI, and set the app's Webhooks
# endpoint to {your public backend URL}/api/quickbooks/webhook — the
# Verifier Token shown there goes in QBO_WEBHOOK_VERIFIER_TOKEN.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=
